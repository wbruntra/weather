# Copy to .env and adjust. Bun loads .env automatically — do not add dotenv.
#   cp .env.example .env

# Required in production; the app refuses to boot without it when
# NODE_ENV=production. Generate one with:
#   bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
JWT_SECRET=

# Token lifetime (zeit/ms format: 60s, 24h, 7d).
JWT_EXPIRES_IN=24h

# Comma-separated allowed browser origins for cross-origin API calls.
# Leave empty in development — Vite proxies /api, so requests are same-origin.
CORS_ORIGINS=

# Overrides the SQLite file path. Defaults to database/demo.sqlite3
# (or demo_test.sqlite3 when NODE_ENV=test).
# DB_URL=

# Password used by `bun run db:seed`. Must be at least 8 characters.
SEED_PASSWORD=password123
