{
  "name": "@scaffold/database",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema.ts",
    "./db": "./db.ts"
  },
  "scripts": {
    "db:generate": "bun run ./create-migration.ts",
    "db:migrate": "bun run ./migrate.ts",
    "db:seed": "bun run ./seed.ts",
    "db:reset": "bun run ./reset.ts",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "kysely": "^0.29.6",
    "kysely-bun-dialects": "^1.0.0"
  }
}
